//==================================================
// 🎨 رسم الصفقة الناشطة
//==================================================
var box   t_blue_bx  = box.new(0, 0.0, 0, 0.0, border_width = 0, bgcolor = color.new(color.gray, 100))
var box   t_red_bx   = box.new(0, 0.0, 0, 0.0, border_width = 0, bgcolor = color.new(color.gray, 100))
var line  t_entry_ln = line.new(0, 0.0, 0, 0.0, color = color.new(color.gray, 100), style = line.style_dashed, width = 2)
var line  t_tp1_ln   = line.new(0, 0.0, 0, 0.0, color = color.new(color.gray, 100), style = line.style_dashed, width = 1)
var line  t_tp2_ln   = line.new(0, 0.0, 0, 0.0, color = color.new(color.gray, 100), style = line.style_solid,  width = 1)
var line  t_sl_ln    = line.new(0, 0.0, 0, 0.0, color = color.new(color.gray, 100), style = line.style_solid,  width = 1)
var line  t_reb_ln   = line.new(0, 0.0, 0, 0.0, color = color.new(color.gray, 100), style = line.style_dashed, width = 1)
var label t_entry_lb = label.new(0, 0.0, "", style = label.style_label_left, color = color.new(color.gray, 100), textcolor = color.white, size = size.small)
var label t_tp1_lb   = label.new(0, 0.0, "", style = label.style_label_left, color = color.new(color.gray, 100), textcolor = color.white, size = size.small)
var label t_tp2_lb   = label.new(0, 0.0, "", style = label.style_label_left, color = color.new(color.gray, 100), textcolor = color.white, size = size.small)
var label t_sl_lb    = label.new(0, 0.0, "", style = label.style_label_left, color = color.new(color.gray, 100), textcolor = color.white, size = size.small)
var label t_reb_lb   = label.new(0, 0.0, "", style = label.style_label_left, color = color.new(color.gray, 100), textcolor = color.white, size = size.small)

// إغلاق الرسم عند ضرب TP2 أو SL
if array.get(_trade_active, 0) == 1
    string td = array.get(_trade_dir, 0)
    float  tp = array.get(_trade_tp2, 0)
    float  sl = array.get(_trade_sl,  0)
    bool hit_tp = td == "BUY" ? high >= tp : low  <= tp
    bool hit_sl = td == "BUY" ? low  <= sl : high >= sl
    if hit_tp or hit_sl
        array.set(_trade_active, 0, 0)

// رسم الصفقة الناشطة
if show_trade and array.get(_trade_active, 0) == 1
    string td  = array.get(_trade_dir,    0)
    float  ent = array.get(_trade_entry,  0)
    float  sl  = array.get(_trade_sl,     0)
    float  tp1 = array.get(_trade_tp1,    0)
    float  tp2 = array.get(_trade_tp2,    0)
    float  reb = array.get(_trade_rebuy,  0)
    int    rb_on = array.get(_trade_reb_on, 0)
    int    t_bar = array.get(_trade_bar,    0)
    int    r_bar = bar_index + extend_right

    float blue_top = td == "BUY" ? tp2 : ent
    float blue_bot = td == "BUY" ? ent : tp2
    box.set_lefttop(t_blue_bx, t_bar, blue_top)
    box.set_rightbottom(t_blue_bx, r_bar, blue_bot)
    box.set_bgcolor(t_blue_bx, trade_blue)

    float red_top = td == "BUY" ? ent : sl
    float red_bot = td == "BUY" ? sl  : ent
    box.set_lefttop(t_red_bx, t_bar, red_top)
    box.set_rightbottom(t_red_bx, r_bar, red_bot)
    box.set_bgcolor(t_red_bx, trade_red)

    color ent_col = td == "BUY" ? color.new(#10B981, 0) : color.new(#EF4444, 0)
    line.set_xy1(t_entry_ln, t_bar, ent)
    line.set_xy2(t_entry_ln, r_bar, ent)
    line.set_color(t_entry_ln, ent_col)
    label.set_xy(t_entry_lb, r_bar, ent)
    label.set_text(t_entry_lb, (td == "BUY" ? "🟢 BUY " : "🔴 SELL ") + f_num(ent))
    label.set_color(t_entry_lb, ent_col)
    label.set_textcolor(t_entry_lb, color.white)

    color tp_col = color.new(#3B82F6, 0)
    line.set_xy1(t_tp1_ln, t_bar, tp1)
    line.set_xy2(t_tp1_ln, r_bar, tp1)
    line.set_color(t_tp1_ln, tp_col)
    label.set_xy(t_tp1_lb, r_bar, tp1)
    label.set_text(t_tp1_lb, "TP1 " + f_num(tp1))
    label.set_color(t_tp1_lb, tp_col)
    label.set_textcolor(t_tp1_lb, color.white)

    line.set_xy1(t_tp2_ln, t_bar, tp2)
    line.set_xy2(t_tp2_ln, r_bar, tp2)
    line.set_color(t_tp2_ln, tp_col)
    label.set_xy(t_tp2_lb, r_bar, tp2)
    label.set_text(t_tp2_lb, "TP2 " + f_num(tp2))
    label.set_color(t_tp2_lb, tp_col)
    label.set_textcolor(t_tp2_lb, color.white)

    color sl_col = color.new(#EF4444, 0)
    line.set_xy1(t_sl_ln, t_bar, sl)
    line.set_xy2(t_sl_ln, r_bar, sl)
    line.set_color(t_sl_ln, sl_col)
    label.set_xy(t_sl_lb, r_bar, sl)
    label.set_text(t_sl_lb, "SL " + f_num(sl))
    label.set_color(t_sl_lb, sl_col)
    label.set_textcolor(t_sl_lb, color.white)

    if rb_on == 1
        // التعزيز مفعَّل — الخط ظاهر بقوة + label
        color reb_col = color.new(#EF4444, 0)
        line.set_xy1(t_reb_ln, t_bar, reb)
        line.set_xy2(t_reb_ln, r_bar, reb)
        line.set_color(t_reb_ln, reb_col)
        label.set_xy(t_reb_lb, r_bar, reb)
        label.set_text(t_reb_lb, (td == "BUY" ? "🟩 REBUY " : "🟥 RESELL ") + f_num(reb))
        label.set_color(t_reb_lb, reb_col)
        label.set_textcolor(t_reb_lb, color.white)
    else
        // التعزيز لم يُفعَّل بعد — الخط يظهر كمرجع بشفافية متوسطة + label
        color reb_col_pre = color.new(#EF4444, 50)
        line.set_xy1(t_reb_ln, t_bar, reb)
        line.set_xy2(t_reb_ln, r_bar, reb)
        line.set_color(t_reb_ln, reb_col_pre)
        label.set_xy(t_reb_lb, r_bar, reb)
        label.set_text(t_reb_lb, (td == "BUY" ? "REBUY " : "RESELL ") + f_num(reb))
        label.set_color(t_reb_lb, color.new(#EF4444, 30))
        label.set_textcolor(t_reb_lb, color.white)
else
    box.set_bgcolor(t_blue_bx, color.new(color.gray, 100))
    box.set_bgcolor(t_red_bx,  color.new(color.gray, 100))
    line.set_color(t_entry_ln, color.new(color.gray, 100))
    line.set_color(t_tp1_ln,   color.new(color.gray, 100))
    line.set_color(t_tp2_ln,   color.new(color.gray, 100))
    line.set_color(t_sl_ln,    color.new(color.gray, 100))
    line.set_color(t_reb_ln,   color.new(color.gray, 100))
    label.set_color(t_entry_lb, color.new(color.gray, 100))
    label.set_color(t_tp1_lb,   color.new(color.gray, 100))
    label.set_color(t_tp2_lb,   color.new(color.gray, 100))
    label.set_color(t_sl_lb,    color.new(color.gray, 100))
    label.set_color(t_reb_lb,   color.new(color.gray, 100))
    label.set_text(t_entry_lb, "")
    label.set_text(t_tp1_lb,   "")
    label.set_text(t_tp2_lb,   "")
    label.set_text(t_sl_lb,    "")
    label.set_text(t_reb_lb,   "")

//==================================================
// 🔔 alertcondition — لواجهة "Add alert"
//==================================================
bool buy_any    = be1 or be2 or be3 or be4 or be5 or be6 or be7 or be8 or be9 or be10
bool rebuy_any  = re1 or re2 or re3 or re4 or re5 or re6 or re7 or re8 or re9 or re10
bool sell_any   = se1 or se2 or se3 or se4 or se5 or se6 or se7 or se8 or se9 or se10
bool resell_any = rs1 or rs2 or rs3 or rs4 or rs5 or rs6 or rs7 or rs8 or rs9 or rs10

alertcondition(buy_any,      "BUY",                 "🟢 BUY")
alertcondition(rebuy_any,    "REBUY",               "🟩 REBUY")
alertcondition(sell_any,     "SELL",                "🔴 SELL")
alertcondition(resell_any,   "RESELL",              "🟥 RESELL")
alertcondition(up_n >= 1,    "M15 BUY BREAK",       "🟢⬆️ M15 BREAK")
alertcondition(dn_n >= 1,    "M15 SELL BREAK",      "🔴⬇️ M15 BREAK")
alertcondition(up_n >= 2,    "M15 MULTI BUY BREAK", "🟢⏫ M15 MULTI BREAK")
alertcondition(dn_n >= 2,    "M15 MULTI SELL BREAK","🔴⏬ M15 MULTI BREAK")
alertcondition(h1_up_brk_evt,   "H1 BUY BREAK",        "🟢⬆️ H1 BREAK")
alertcondition(h1_dn_brk_evt,   "H1 SELL BREAK",       "🔴⬇️ H1 BREAK")
alertcondition(h1_up_multi_evt, "H1 MULTI BUY BREAK",  "🟢⏫ H1 MULTI BREAK")
alertcondition(h1_dn_multi_evt, "H1 MULTI SELL BREAK", "🔴⏬ H1 MULTI BREAK")
alertcondition(h4_up_brk_evt,   "H4 BUY BREAK",        "🟢⬆️ H4 BREAK")
alertcondition(h4_dn_brk_evt,   "H4 SELL BREAK",       "🔴⬇️ H4 BREAK")
alertcondition(h4_up_multi_evt, "H4 MULTI BUY BREAK",  "🟢⏫ H4 MULTI BREAK")
alertcondition(h4_dn_multi_evt, "H4 MULTI SELL BREAK", "🔴⏬ H4 MULTI BREAK")
alertcondition(true,         "Any alert() function call", "Gold Sniper alert")
