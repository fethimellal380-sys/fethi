//@version=5
indicator("Gold Sniper V10 - Ultimate Merged Build", overlay=true, max_boxes_count=500, max_labels_count=500, max_bars_back=500)

//==================================================
// ⚙️ الإعدادات العامة
//==================================================
grp_gen = "الإعدادات العامة"

offset        = input.float(1.0,  "حساسية اللمس",             minval=0.1, step=0.1, group=grp_gen)
show_dist     = input.float(0.0,  "مسافة إظهار المناطق (0=الكل)", step=1, group=grp_gen)
extend_right  = input.int(35,     "امتداد البوكس يميناً",     minval=5, maxval=100, group=grp_gen)
cooldown_bars = input.int(0,      "Cooldown بين الإشارات",    minval=0, group=grp_gen)
label_off     = input.int(0,      "إزاحة الأرقام يميناً",     group=grp_gen)

grp_col = "ألوان المناطق"
buy_c  = input.color(color.new(color.lime, 84), "منطقة شراء (أخضر)", group=grp_col)
sell_c = input.color(color.new(color.red,  84), "منطقة بيع (أحمر)",  group=grp_col)

grp_mtf = "تنبيهات الفريمات"
en_15m = input.bool(true, "تفعيل M15", group=grp_mtf)
en_1h  = input.bool(true, "تفعيل H1",  group=grp_mtf)
en_4h  = input.bool(true, "تفعيل H4",  group=grp_mtf)

//==================================================
// 📥 إدخال المناطق (10 مناطق)
//==================================================
z1=input.bool(true,"Z1",inline="1"),   t1=input.float(3665.0,"T",inline="1"), b1=input.float(3655.0,"B",inline="1")
z2=input.bool(true,"Z2",inline="2"),   t2=input.float(3425.0,"T",inline="2"), b2=input.float(3415.0,"B",inline="2")
z3=input.bool(true,"Z3",inline="3"),   t3=input.float(3300.0,"T",inline="3"), b3=input.float(3290.0,"B",inline="3")
z4=input.bool(true,"Z4",inline="4"),   t4=input.float(3200.0,"T",inline="4"), b4=input.float(3190.0,"B",inline="4")
z5=input.bool(true,"Z5",inline="5"),   t5=input.float(3100.0,"T",inline="5"), b5=input.float(3090.0,"B",inline="5")
z6=input.bool(true,"Z6",inline="6"),   t6=input.float(3000.0,"T",inline="6"), b6=input.float(2990.0,"B",inline="6")
z7=input.bool(true,"Z7",inline="7"),   t7=input.float(2900.0,"T",inline="7"), b7=input.float(2890.0,"B",inline="7")
z8=input.bool(true,"Z8",inline="8"),   t8=input.float(2800.0,"T",inline="8"), b8=input.float(2790.0,"B",inline="8")
z9=input.bool(true,"Z9",inline="9"),   t9=input.float(2700.0,"T",inline="9"), b9=input.float(2690.0,"B",inline="9")
z10=input.bool(true,"Z10",inline="10"),t10=input.float(2600.0,"T",inline="10"),b10=input.float(2590.0,"B",inline="10")

en_arr = array.from(z1,z2,z3,z4,z5,z6,z7,z8,z9,z10)
tp_arr = array.from(t1,t2,t3,t4,t5,t6,t7,t8,t9,t10)
bt_arr = array.from(b1,b2,b3,b4,b5,b6,b7,b8,b9,b10)


//==================================================
// 🛰️ بيانات MTF (Anti-Repaint: close[1] + lookahead_on)
//==================================================
[m15_open_r, m15_close_r, m15_prev_r] = request.security(syminfo.tickerid, "15",  [open[1], close[1], close[2]], lookahead=barmerge.lookahead_on)
[h1_open_r,  h1_close_r,  h1_prev_r]  = request.security(syminfo.tickerid, "60",  [open[1], close[1], close[2]], lookahead=barmerge.lookahead_on)
[h4_open_r,  h4_close_r,  h4_prev_r]  = request.security(syminfo.tickerid, "240", [open[1], close[1], close[2]], lookahead=barmerge.lookahead_on)

m15_event = ta.change(time("15"))  != 0
h1_event  = ta.change(time("60"))  != 0
h4_event  = ta.change(time("240")) != 0

//==================================================
// 🧠 نظام الذاكرة (10 مناطق)
//==================================================
var zone_role       = array.new_string(10, "NEUTRAL")
var zone_states     = array.new_string(10, "IDLE")
var buy_reinforced  = array.new_bool(10, false)
var sell_reinforced = array.new_bool(10, false)
var freeze_main     = array.new_bool(10, false)
var last_trade_bar  = array.new_int(10, -1)
var buy_lock_arr    = array.new_bool(10, false)
var sell_lock_arr   = array.new_bool(10, false)
var hit_zones       = array.new_bool(10, false)

// Inside Box Rearm (من V9)
var rearm_armed     = array.new_bool(10, false)
var last_m_bar      = array.new_int(10, -1)
var last_r_bar      = array.new_int(10, -1)

// Break states per zone per timeframe (من V9)
var break_state_m15 = array.new_string(10, "NONE")
var break_state_h1  = array.new_string(10, "NONE")
var break_state_h4  = array.new_string(10, "NONE")

if barstate.isnew
    for i = 0 to 9
        array.set(buy_lock_arr,  i, false)
        array.set(sell_lock_arr, i, false)
        array.set(hit_zones,     i, false)

//==================================================
// 🎨 كائنات الرسم
//==================================================
var boxes  = array.new_box(10)
var labels = array.new_label(10)

if barstate.isfirst
    for i = 0 to 9
        array.set(boxes,  i, box.new(na, na, na, na, border_width=1))
        array.set(labels, i, label.new(x=bar_index, y=close, text="",
             xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_label_center, size=size.normal))


//==================================================
// 🧮 متغيرات تجميع الكسر (Reset عند بداية كل شمعة)
//==================================================
var float bull_min = na, var float bull_max = na, var int bull_count = 0
var float bear_min = na, var float bear_max = na, var int bear_count = 0

var int   m15_up_cnt = 0, var float m15_up_min = na, var float m15_up_max = na
var int   m15_dn_cnt = 0, var float m15_dn_min = na, var float m15_dn_max = na
var int   h1_up_cnt  = 0, var float h1_up_min  = na, var float h1_up_max  = na
var int   h1_dn_cnt  = 0, var float h1_dn_min  = na, var float h1_dn_max  = na
var int   h4_up_cnt  = 0, var float h4_up_min  = na, var float h4_up_max  = na
var int   h4_dn_cnt  = 0, var float h4_dn_min  = na, var float h4_dn_max  = na

if barstate.isconfirmed
    bull_min := na, bull_max := na, bull_count := 0
    bear_min := na, bear_max := na, bear_count := 0

if m15_event
    m15_up_cnt := 0, m15_up_min := na, m15_up_max := na
    m15_dn_cnt := 0, m15_dn_min := na, m15_dn_max := na

if h1_event
    h1_up_cnt := 0, h1_up_min := na, h1_up_max := na
    h1_dn_cnt := 0, h1_dn_min := na, h1_dn_max := na

if h4_event
    h4_up_cnt := 0, h4_up_min := na, h4_up_max := na
    h4_dn_cnt := 0, h4_dn_min := na, h4_dn_max := na

//==================================================
// 🔧 دوال مساعدة
//==================================================
f_num(v) => str.tostring(v, "#.##")


//==================================================
// 🔍 المرور الأول: تحديد المناطق الملموسة (للـ Dynamic Reclaim)
//==================================================
for i = 0 to 9
    if array.get(en_arr, i)
        float t_v = math.max(array.get(tp_arr, i), array.get(bt_arr, i))
        float b_v = math.min(array.get(tp_arr, i), array.get(bt_arr, i))
        if high >= b_v - offset and low <= t_v + offset
            array.set(hit_zones, i, true)

//==================================================
// ⚙️ المرور الرئيسي على كل المناطق
//==================================================
for i = 0 to 9

    if array.get(en_arr, i)

        float top_v = math.max(array.get(tp_arr, i), array.get(bt_arr, i))
        float bot_v = math.min(array.get(tp_arr, i), array.get(bt_arr, i))
        float mid_v = (top_v + bot_v) / 2

        string state        = array.get(zone_states, i)
        string current_role = array.get(zone_role, i)
        bool   frozen       = array.get(freeze_main, i)
        bool   armed        = array.get(rearm_armed, i)
        bool   trade_ok     = (bar_index - array.get(last_trade_bar, i)) > cooldown_bars
        bool   lock_buy     = array.get(buy_lock_arr, i)
        bool   lock_sell    = array.get(sell_lock_arr, i)

        //--------------------------------------------
        // ENGINE 01: Side Detection
        //--------------------------------------------
        if close > top_v
            current_role := array.get(zone_role, i) == "RESISTANCE" ? "RESISTANCE" : current_role
        // (الـ role يُحدَّث فقط عبر الكسر — الـ side يُكشف من الموقع)
        string side = close > top_v ? "SUP" : close < bot_v ? "RES" : array.get(zone_states, i) == "BUYING" ? "SUP" : "RES"

        //--------------------------------------------
        // ENGINE 03 (V9): Inside Box Rearm — M15
        //--------------------------------------------
        if m15_event
            float body_top = math.max(m15_open_r, m15_close_r)
            float body_bot = math.min(m15_open_r, m15_close_r)
            if body_top <= top_v and body_bot >= bot_v
                array.set(rearm_armed, i, true)
                armed := true

        //--------------------------------------------
        // ENGINE 02 (V9): Distance Reset Layer
        //--------------------------------------------
        if armed
            bool clear_reset = side == "SUP" ? low > top_v + (offset * 3) : high < bot_v - (offset * 3)
            if clear_reset
                array.set(rearm_armed,  i, false)
                array.set(last_m_bar,   i, -1)
                array.set(last_r_bar,   i, -1)
                array.set(freeze_main,  i, false)
                array.set(buy_reinforced,  i, false)
                array.set(sell_reinforced, i, false)
                frozen := false
                armed  := false


        //--------------------------------------------
        // Dynamic Reclaim (V202): إعادة تفعيل إذا لُمست منطقة أخرى
        //--------------------------------------------
        for j = 0 to 9
            if j != i and array.get(hit_zones, j)
                if (state == "BUYING" and j > i) or (state == "SELLING" and j < i)
                    array.set(zone_states,     i, "IDLE")
                    array.set(freeze_main,     i, false)
                    array.set(buy_reinforced,  i, false)
                    array.set(sell_reinforced, i, false)
                    state  := "IDLE"
                    frozen := false

        bool zone_broken_this_bar = false

        //--------------------------------------------
        // الكسر الرئيسي (Real-time على فريم الشارت)
        //--------------------------------------------
        if barstate.isconfirmed
            bool is_break_up = close > top_v and low  <= top_v
            bool is_break_dn = close < bot_v and high >= bot_v

            if is_break_up or is_break_dn
                zone_broken_this_bar := true

                if is_break_up
                    array.set(sell_lock_arr, i, true)
                    if array.get(zone_role, i) != "SUPPORT"
                        array.set(zone_role, i, "SUPPORT")
                        bull_count += 1
                        bull_min := na(bull_min) ? bot_v : math.min(bull_min, bot_v)
                        bull_max := na(bull_max) ? top_v : math.max(bull_max, top_v)

                if is_break_dn
                    array.set(buy_lock_arr, i, true)
                    if array.get(zone_role, i) != "RESISTANCE"
                        array.set(zone_role, i, "RESISTANCE")
                        bear_count += 1
                        bear_min := na(bear_min) ? bot_v : math.min(bear_min, bot_v)
                        bear_max := na(bear_max) ? top_v : math.max(bear_max, top_v)

                array.set(zone_states,     i, "IDLE")
                array.set(freeze_main,     i, false)
                array.set(buy_reinforced,  i, false)
                array.set(sell_reinforced, i, false)

        //--------------------------------------------
        // تجميع كسور MTF — M15 (Anti-Repaint)
        //--------------------------------------------
        if en_15m and m15_event and not na(m15_prev_r) and not na(m15_close_r)
            if m15_prev_r <= top_v and m15_close_r > top_v and array.get(break_state_m15, i) != "UP"
                array.set(break_state_m15, i, "UP")
                m15_up_cnt += 1
                m15_up_min := na(m15_up_min) ? bot_v : math.min(m15_up_min, bot_v)
                m15_up_max := na(m15_up_max) ? top_v : math.max(m15_up_max, top_v)
            if m15_prev_r >= bot_v and m15_close_r < bot_v and array.get(break_state_m15, i) != "DOWN"
                array.set(break_state_m15, i, "DOWN")
                m15_dn_cnt += 1
                m15_dn_min := na(m15_dn_min) ? bot_v : math.min(m15_dn_min, bot_v)
                m15_dn_max := na(m15_dn_max) ? top_v : math.max(m15_dn_max, top_v)

        //--------------------------------------------
        // تجميع كسور MTF — H1 (Anti-Repaint)
        //--------------------------------------------
        if en_1h and h1_event and not na(h1_prev_r) and not na(h1_close_r)
            if h1_prev_r <= top_v and h1_close_r > top_v and array.get(break_state_h1, i) != "UP"
                array.set(break_state_h1, i, "UP")
                h1_up_cnt += 1
                h1_up_min := na(h1_up_min) ? bot_v : math.min(h1_up_min, bot_v)
                h1_up_max := na(h1_up_max) ? top_v : math.max(h1_up_max, top_v)
            if h1_prev_r >= bot_v and h1_close_r < bot_v and array.get(break_state_h1, i) != "DOWN"
                array.set(break_state_h1, i, "DOWN")
                h1_dn_cnt += 1
                h1_dn_min := na(h1_dn_min) ? bot_v : math.min(h1_dn_min, bot_v)
                h1_dn_max := na(h1_dn_max) ? top_v : math.max(h1_dn_max, top_v)

        //--------------------------------------------
        // تجميع كسور MTF — H4 (Anti-Repaint)
        //--------------------------------------------
        if en_4h and h4_event and not na(h4_prev_r) and not na(h4_close_r)
            if h4_prev_r <= top_v and h4_close_r > top_v and array.get(break_state_h4, i) != "UP"
                array.set(break_state_h4, i, "UP")
                h4_up_cnt += 1
                h4_up_min := na(h4_up_min) ? bot_v : math.min(h4_up_min, bot_v)
                h4_up_max := na(h4_up_max) ? top_v : math.max(h4_up_max, top_v)
            if h4_prev_r >= bot_v and h4_close_r < bot_v and array.get(break_state_h4, i) != "DOWN"
                array.set(break_state_h4, i, "DOWN")
                h4_dn_cnt += 1
                h4_dn_min := na(h4_dn_min) ? bot_v : math.min(h4_dn_min, bot_v)
                h4_dn_max := na(h4_dn_max) ? top_v : math.max(h4_dn_max, top_v)


        //--------------------------------------------
        // ENGINE 04 & 05: BUY / SELL Touch Alerts
        //--------------------------------------------
        bool touch_top = not zone_broken_this_bar and (high >= top_v - offset and low <= top_v + offset)
        bool touch_bot = not zone_broken_this_bar and (low  <= bot_v + offset and high >= bot_v - offset)

        string role_i = array.get(zone_role, i)
        state         := array.get(zone_states, i)
        frozen        := array.get(freeze_main, i)

        // 🔴 SELL
        if (role_i == "RESISTANCE" or role_i == "NEUTRAL") and touch_top and not frozen and state != "SELLING" and trade_ok and not lock_sell
            array.set(zone_states,     i, "SELLING")
            array.set(freeze_main,     i, true)
            array.set(sell_reinforced, i, false)
            array.set(last_trade_bar,  i, bar_index)
            array.set(last_m_bar,      i, bar_index)
            alert("🔴 بيع [ " + f_num(bot_v) + " ⟶ " + f_num(top_v) + " ]", alert.freq_once_per_bar)

        else if (role_i == "RESISTANCE" or role_i == "NEUTRAL") and touch_top and state == "SELLING" and not array.get(sell_reinforced, i) and not lock_sell and array.get(last_r_bar, i) != bar_index
            array.set(sell_reinforced, i, true)
            array.set(last_r_bar,      i, bar_index)
            alert("🟥 تعزيز بيع [ " + f_num(top_v) + " ]", alert.freq_once_per_bar)

        // 🟢 BUY
        if (role_i == "SUPPORT" or role_i == "NEUTRAL") and touch_bot and not frozen and state != "BUYING" and trade_ok and not lock_buy
            array.set(zone_states,    i, "BUYING")
            array.set(freeze_main,    i, true)
            array.set(buy_reinforced, i, false)
            array.set(last_trade_bar, i, bar_index)
            array.set(last_m_bar,     i, bar_index)
            alert("🟢 شراء [ " + f_num(bot_v) + " ⟶ " + f_num(top_v) + " ]", alert.freq_once_per_bar)

        else if (role_i == "SUPPORT" or role_i == "NEUTRAL") and touch_bot and state == "BUYING" and not array.get(buy_reinforced, i) and not lock_buy and array.get(last_r_bar, i) != bar_index
            array.set(buy_reinforced, i, true)
            array.set(last_r_bar,     i, bar_index)
            alert("🟩 تعزيز شراء [ " + f_num(bot_v) + " ]", alert.freq_once_per_bar)

        //--------------------------------------------
        // 🎨 الرسم
        //--------------------------------------------
        if barstate.islast

            box   bx_ref = array.get(boxes,  i)
            label lb_ref = array.get(labels, i)

            bool viz = show_dist <= 0 or math.abs(close - mid_v) <= show_dist

            if viz
                string role_now = array.get(zone_role, i)
                color  f_col    = role_now == "SUPPORT"    ? buy_c  :
                                  role_now == "RESISTANCE" ? sell_c :
                                  (bot_v > close ? sell_c : buy_c)

                int right_p = bar_index + extend_right

                box.set_left(bx_ref,         bar_index - 500)
                box.set_right(bx_ref,         right_p)
                box.set_top(bx_ref,            top_v)
                box.set_bottom(bx_ref,         bot_v)
                box.set_bgcolor(bx_ref,        f_col)
                box.set_border_color(bx_ref,   color.new(f_col, 40))

                label.set_x(lb_ref,            right_p + label_off)
                label.set_y(lb_ref,            mid_v)
                label.set_text(lb_ref,         "[ " + f_num(bot_v) + " ⟶ " + f_num(top_v) + " ]")
                label.set_style(lb_ref,        label.style_label_center)
                label.set_size(lb_ref,         size.normal)
                label.set_color(lb_ref,        color.new(f_col, 15))
                label.set_textcolor(lb_ref,    color.black)
            else
                box.set_bgcolor(bx_ref,        color(na))
                box.set_border_color(bx_ref,   color(na))
                label.set_text(lb_ref,         "")


//==================================================
// 📢 تنبيهات الكسر الرئيسي (مجمّعة)
//==================================================
if barstate.isconfirmed
    if bull_count > 0
        alert(
             (bull_count > 1 ? "⚡⏫ كسر متتالي " : "⚡⬆️ كسر ")
             + "🟢 [ " + f_num(bull_min) + " ⟶ " + f_num(bull_max) + " ]",
             alert.freq_once_per_bar_close)

    if bear_count > 0
        alert(
             (bear_count > 1 ? "⚡⬇️ كسر متتالي " : "⚡⬇️ كسر ")
             + "🔴 [ " + f_num(bear_min) + " ⟶ " + f_num(bear_max) + " ]",
             alert.freq_once_per_bar_close)

//==================================================
// 📢 تنبيهات MTF — M15 (مع نطاق سعري كامل)
//==================================================
if en_15m and m15_event
    if m15_up_cnt > 0
        alert(
             (m15_up_cnt > 1 ? "⚡⏫ كسر M15 متتالي 🟢 [ " : "⚡⬆️ كسر M15 🟢 [ ")
             + f_num(m15_up_min) + " ⟶ " + f_num(m15_up_max) + " ]",
             alert.freq_once_per_bar_close)
    if m15_dn_cnt > 0
        alert(
             (m15_dn_cnt > 1 ? "⚡⬇️ كسر M15 متتالي 🔴 [ " : "⚡⬇️ كسر M15 🔴 [ ")
             + f_num(m15_dn_min) + " ⟶ " + f_num(m15_dn_max) + " ]",
             alert.freq_once_per_bar_close)

//==================================================
// 📢 تنبيهات MTF — H1 (مع نطاق سعري كامل)
//==================================================
if en_1h and h1_event
    if h1_up_cnt > 0
        alert(
             (h1_up_cnt > 1 ? "⚡⏫ كسر H1 متتالي 🟢 [ " : "⚡⬆️ كسر H1 🟢 [ ")
             + f_num(h1_up_min) + " ⟶ " + f_num(h1_up_max) + " ]",
             alert.freq_once_per_bar_close)
    if h1_dn_cnt > 0
        alert(
             (h1_dn_cnt > 1 ? "⚡⬇️ كسر H1 متتالي 🔴 [ " : "⚡⬇️ كسر H1 🔴 [ ")
             + f_num(h1_dn_min) + " ⟶ " + f_num(h1_dn_max) + " ]",
             alert.freq_once_per_bar_close)

//==================================================
// 📢 تنبيهات MTF — H4 (مع نطاق سعري كامل)
//==================================================
if en_4h and h4_event
    if h4_up_cnt > 0
        alert(
             (h4_up_cnt > 1 ? "🚀⏫ كسر H4 متتالي 🟢 [ " : "🚀⬆️ كسر H4 🟢 [ ")
             + f_num(h4_up_min) + " ⟶ " + f_num(h4_up_max) + " ]",
             alert.freq_once_per_bar_close)
    if h4_dn_cnt > 0
        alert(
             (h4_dn_cnt > 1 ? "🚀⬇️ كسر H4 متتالي 🔴 [ " : "🚀⬇️ كسر H4 🔴 [ ")
             + f_num(h4_dn_min) + " ⟶ " + f_num(h4_dn_max) + " ]",
             alert.freq_once_per_bar_close)
